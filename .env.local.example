# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored, so your password never gets committed.

# The Gmail address the form will send FROM (needs an App Password, not your normal password)
GMAIL_USER=youraddress@gmail.com

# A 16-character Gmail "App Password" — see README.md for how to generate one
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: where messages get delivered TO. Defaults to GMAIL_USER if left out.
CONTACT_TO_EMAIL=suryavigneshpro@gmail.com
